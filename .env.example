# Copy to .env and fill in (never commit .env)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Contact email sent in the Nominatim User-Agent (config time only, not EXPO_PUBLIC_).
